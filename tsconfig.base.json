{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@flowboard/contracts": ["./packages/contracts/src/index.ts"],
      "@flowboard/server": ["./packages/server/src/index.ts"],
      "@flowboard/dsh-service": ["./packages/dsh-service/src/index.ts"],
      "@flowboard/dsh-client": ["./packages/dsh-client/src/index.ts"],
      "@flowboard/dsh": ["./packages/dsh/src/index.ts"]
    },
    "types": ["node"]
  }
}
