{
  "name": "flowboard-plugin-workspace",
  "version": "0.1.2-alpha.3",
  "author": "构序科技",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "clean": "node scripts/clean.mjs",
    "build:host": "tsc -b tsconfig.host.json && tsdown --config tsdown.host.config.ts && tsdown --config tsdown.plugin.config.ts",
    "build:client": "tsc -b tsconfig.client.json && tsdown --config tsdown.client.config.ts",
    "build": "pnpm run clean && pnpm run build:host && pnpm run build:client && pnpm run plugin:stage",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json --pretty false",
    "dynamic:check": "node scripts/validate-dynamic.mjs",
    "test:run": "vitest run",
    "test": "pnpm run typecheck && pnpm run test:run",
    "check": "pnpm run dynamic:check && pnpm run test && pnpm run build && pnpm run whisper:check && pnpm run manifest:check && pnpm run pack:check",
    "manifest:check": "node scripts/validate-manifests.mjs",
    "whisper:check": "node scripts/verify-whisper.mjs",
    "plugin:stage": "node scripts/stage-plugin-assets.mjs",
    "plugin:pack": "pnpm --filter @flowboard/dsh pack --pack-destination ./artifacts",
    "plugin:package-check": "node scripts/verify-plugin-package.mjs",
    "plugin:install-check": "node scripts/verify-plugin-install.mjs",
    "release:check": "pnpm run check && pnpm run plugin:pack && pnpm run plugin:package-check && pnpm run plugin:install-check",
    "pack:check": "pnpm --filter @flowboard/dsh pack --pack-destination ./artifacts --dry-run",
    "server": "tsx packages/server/src/cli.ts",
    "worker": "tsx packages/server/src/worker-cli.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.0-rc.6",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
